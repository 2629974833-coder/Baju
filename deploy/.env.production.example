# Copy to deploy/.env.production. Never commit the populated file.
# A DNS hostname only, for example framekeep.example.com; no scheme, port or path.
FRAMEKEEP_DOMAIN=

# Required: generate a random value with secrets.token_urlsafe(32).
FRAMEKEEP_ADMIN_TOKEN=

# Change all three together if this subnet overlaps host routes or Docker networks.
FRAMEKEEP_NETWORK_SUBNET=172.30.246.0/24
FRAMEKEEP_PROXY_IP=172.30.246.2
FRAMEKEEP_BACKEND_IP=172.30.246.3

FRAMEKEEP_MAX_DOWNLOAD_BYTES=2147483648
FRAMEKEEP_MIN_FREE_BYTES=536870912

# Override with a tested immutable digest when pinning a release.
FRAMEKEEP_CADDY_IMAGE=caddy:2.11.9-alpine
