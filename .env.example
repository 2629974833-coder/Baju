# Docker Compose configuration. Copy to .env, generate your own token, chmod 600 .env.
# Empty tokens are rejected by Compose; the backend requires at least 24 characters.
FRAMEKEEP_ADMIN_TOKEN=
FRAMEKEEP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],testserver
FRAMEKEEP_PUBLISH_PORT=4173
FRAMEKEEP_MAX_DOWNLOAD_BYTES=2147483648
FRAMEKEEP_MIN_FREE_BYTES=536870912
FRAMEKEEP_TRUST_FAKE_DNS=0
# Native processing may override a local font file; Docker includes Noto CJK.
# FRAMEKEEP_FONT_PATH=/absolute/path/to/font.ttf

# compose.yaml fixes the container bind to 0.0.0.0:4173 and storage to /var/lib/framekeep.
# Native startup also loads .env. Existing shell environment variables take precedence.
# Only set FRAMEKEEP_TRUST_FAKE_DNS=1 when you deliberately trust a known local Fake-IP/TUN proxy.
